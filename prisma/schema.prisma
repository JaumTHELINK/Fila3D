generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  tipo  String
}

model Material {
  id            Int     @id @default(autoincrement())
  nome          String
  tipo          String
  precoPorGrama Float
  estoqueGramas Float
}
